---
import "../styles/global.css";
import githubData from "../data/github.json";
import { createDocsSchema, createHomeSchema } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "dotcfg — Rust configuration, your way",
  description = "Documentation for dotcfg, flexible configuration management for Rust applications.",
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(currentPath === "/" ? "/" : currentPath, Astro.site);
const socialImageUrl = new URL("/brand/og.png", Astro.site);
const pageTitle = title.replace(/\s+[—-]\s+dotcfg$/, "");
const schema = currentPath === "/"
  ? createHomeSchema(description)
  : createDocsSchema({ title: pageTitle, description, path: currentPath });
const starCount = Number.isFinite(githubData.stars) && githubData.stars > 0 ? githubData.stars : null;
const groups = [
  { label: "Basics", links: [["Getting started", "/getting-started"], ["Directory strategies", "/directory-strategies"], ["Formats", "/formats"]] },
  { label: "Core API", links: [["Loading & saving", "/loading-saving"], ["Key access", "/key-access"], ["Environment overrides", "/environment"]] },
  { label: "Examples", links: [["Examples", "/examples"]] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fbfaf7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dotcfg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="dotcfg — Rust configuration, your way" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="dotcfg — Rust configuration, your way" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/"><span>dot</span>cfg</a>
      <div class="header-actions">
        <a class="github-star" href="https://github.com/Spectra010s/dotcfg" aria-label={starCount ? `Star dotcfg on GitHub. ${starCount} stars.` : "Star dotcfg on GitHub"}>
          <span class="star-icon" aria-hidden="true">☆{starCount && <span class="star-count">{starCount}</span>}</span>
          <span>Star<span class="star-suffix"> on GitHub</span></span>
        </a>
        <button class="menu-button" type="button" aria-label="Open documentation navigation" aria-controls="mobile-nav" aria-expanded="false" data-menu-open>
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <div class="nav-backdrop" data-nav-backdrop></div>
    <aside class="mobile-nav" id="mobile-nav" aria-label="Documentation navigation" data-mobile-nav>
      <div class="mobile-nav-header">
        <a class="brand" href="/"><span>dot</span>cfg</a>
        <button class="nav-close" type="button" aria-label="Close documentation navigation" data-menu-close>×</button>
      </div>
      <div class="mobile-nav-scroll">
        {groups.map((group) => (
          <section class="nav-group">
            <p class="sidebar-title">{group.label}</p>
            <nav>{group.links.map(([label, href]) => <a href={href} class:list={{ active: currentPath === href }}>{label}</a>)}</nav>
          </section>
        ))}
      </div>
    </aside>

    <div class="shell">
      <aside class="sidebar">
        <div class="sidebar-scroll">
          {groups.map((group) => (
            <section class="nav-group">
              <p class="sidebar-title">{group.label}</p>
              <nav>{group.links.map(([label, href]) => <a href={href} class:list={{ active: currentPath === href }}>{label}</a>)}</nav>
            </section>
          ))}
        </div>
      </aside>
      <div class="content-column">
        <main><slot /></main>
        <footer class="site-footer">
          <nav aria-label="dotcfg external links">
            <a href="https://docs.rs/dotcfg">API Reference <span>↗</span></a>
            <a href="https://crates.io/crates/dotcfg">crates.io <span>↗</span></a>
            <a href="https://github.com/Spectra010s/dotcfg">GitHub <span>↗</span></a>
          </nav>
          <p>Built by <a href="https://github.com/Spectra010s">Spectra010s <span>↗</span></a></p>
        </footer>
      </div>
    </div>

    <script is:inline>
      const nav = document.querySelector('[data-mobile-nav]');
      const backdrop = document.querySelector('[data-nav-backdrop]');
      const openButton = document.querySelector('[data-menu-open]');
      const closeButton = document.querySelector('[data-menu-close]');
      const setNavOpen = (open) => {
        nav?.classList.toggle('open', open);
        backdrop?.classList.toggle('open', open);
        document.body.classList.toggle('nav-open', open);
        openButton?.setAttribute('aria-expanded', String(open));
      };
      openButton?.addEventListener('click', () => setNavOpen(true));
      closeButton?.addEventListener('click', () => setNavOpen(false));
      backdrop?.addEventListener('click', () => setNavOpen(false));
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setNavOpen(false); });
    </script>
  </body>
</html>
