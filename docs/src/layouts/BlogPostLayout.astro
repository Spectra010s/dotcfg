---
import DocsLayout from "./DocsLayout.astro";
import { createBlogPostSchema } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  path: string;
  publishedAt: Date;
  modifiedAt?: Date;
  tags?: string[];
  version?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, path, publishedAt, modifiedAt, tags = [], version, headings = [] } = Astro.props;
const formattedDate = publishedAt.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const schema = createBlogPostSchema({
  title,
  description,
  path,
  publishedAt,
  modifiedAt,
  tags,
  version,
});
---

<DocsLayout
  title={`${title} — dotcfg`}
  description={description}
  schema={schema}
  ogType="article"
  publishedAt={publishedAt}
  modifiedAt={modifiedAt}
  toc={headings}
>
  <article class="mt-1">
    <header class="mb-[42px] border-b border-border pb-[30px] max-[760px]:mb-[34px] max-[760px]:pb-6">
      <a class="mb-6 inline-block text-[13px] font-bold text-primary" href="/blog">← Blog</a>
      <h1 class="m-0 mb-4 text-[clamp(38px,5.5vw,58px)] max-[760px]:text-[40px]">{title}</h1>
      <p class="mb-[18px] max-w-[680px] text-[19px] leading-[1.55] text-muted-foreground max-[760px]:text-[17px]">{description}</p>
      <div class="flex flex-wrap gap-x-[14px] gap-y-2 text-xs text-muted-foreground">
        <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
        {version && <span class="rounded-full border border-border px-[7px] py-0.5">dotcfg {version}</span>}
        {tags.map((tag) => <span class="rounded-full border border-border px-[7px] py-0.5">{tag}</span>)}
      </div>
    </header>
    <div class="max-w-[720px] max-[760px]:max-w-none">
      <slot />
    </div>
  </article>
</DocsLayout>
