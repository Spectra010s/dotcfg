---
interface Props {
  type?: "info" | "warning" | "success" | "error";
  title?: string;
}

const { type = "info", title } = Astro.props;
const labels = { info: "Information", warning: "Warning", success: "Success", error: "Error" };
const tones = {
  info: "border-[#285f91]/25 bg-[#eff5fa] dark:border-[#9ccbf0]/25 dark:bg-[#202f3a]",
  warning: "border-[#87590c]/25 bg-[#fff8e8] dark:border-[#efc677]/25 dark:bg-[#352e20]",
  success: "border-[#286543]/25 bg-[#edf7f0] dark:border-[#91d3a8]/25 dark:bg-[#203329]",
  error: "border-[#a33333]/25 bg-[#fdf0ef] dark:border-[#f0a0a0]/25 dark:bg-[#392525]",
};
const accents = {
  info: "text-[#285f91] dark:text-[#9ccbf0]",
  warning: "text-[#87590c] dark:text-[#efc677]",
  success: "text-[#286543] dark:text-[#91d3a8]",
  error: "text-[#a33333] dark:text-[#f0a0a0]",
};
---
<aside class:list={["my-6 flex items-start gap-3 rounded-[9px] border px-[18px] py-4 text-sm", tones[type]]} aria-label={labels[type]}>
  <svg class:list={["mt-0.5 h-5 w-5 shrink-0", accents[type]]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {type === "warning" ? (
      <><path d="M10.3 4.4 2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 4.4a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4m0 4h.01" /></>
    ) : (
      <><circle cx="12" cy="12" r="9" />
        {type === "info" && <path d="M12 11v6m0-10h.01" />}
        {type === "success" && <path d="m8 12 3 3 5-6" />}
        {type === "error" && <path d="m9 9 6 6m0-6-6 6" />}
      </>
    )}
  </svg>
  <div class="min-w-0 [overflow-wrap:anywhere] [&_p]:my-2 [&_>_:first-child]:mt-0 [&_>_:last-child]:mb-0">
    {title && <strong class:list={["mb-1 block", accents[type]]}>{title}</strong>}
    <slot />
  </div>
</aside>
