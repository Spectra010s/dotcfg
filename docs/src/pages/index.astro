---
import DocsLayout from "../layouts/DocsLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";

const dependency = (value: string) => `[dependencies]
${value}
serde = { version = "1", features = ["derive"] }`;
const installValues = {
  toml: dependency('dotcfg = "0.3.0"'),
  json: dependency('dotcfg = { version = "0.3.0", features = ["json"] }'),
  yaml: dependency('dotcfg = { version = "0.3.0", features = ["yaml"] }'),
  all: dependency('dotcfg = { version = "0.3.0", features = ["json", "yaml"] }'),
};

const topics = [
  ["Directory strategies", "Use a dot directory, XDG, an exact custom path, or discover project config from ancestors.", "/directory-strategies"],
  ["Multiple formats", "TOML by default, with feature-gated JSON and YAML support.", "/formats"],
  ["Typed key access", "Read and write individual values as Rust types without replacing the whole config.", "/key-access"],
  ["Environment overrides", "Layer environment variables over file configuration for CLI and deployment workflows.", "/environment"],
];

const quickStart = `use dotcfg::DotCfg;
use serde::{Deserialize, Serialize};

#[derive(Serialize, Deserialize, Default)]
struct Config {
    username: String,
    port: u16,
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let cfg = DotCfg::new("mytool");
    cfg.save(&Config { username: "tayo".into(), port: 8080 })?;
    let config: Option<Config> = cfg.load()?;
    Ok(())
}`;

const examples = [
  ["Choose what a missing file means", "Load configuration optionally, require it, or create defaults.", "/loading-saving"],
  ["Keep values typed", "Read and write numbers, booleans, strings, and nested values without flattening your config.", "/key-access"],
  ["Put config where your project needs it", "Move from the default dot directory to XDG, a custom directory, or ancestor discovery.", "/directory-strategies"],
];
---
<DocsLayout>
  <span class="eyebrow">Flexible configuration for Rust</span>
  <h1>Config that fits your application.</h1>
  <p class="lead">dotcfg handles where configuration lives, how it is encoded, and how you read it — without forcing one directory strategy or one access pattern.</p>

  <section class="install-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Get started</span>
        <h2>Start with the format you need.</h2>
      </div>
      <a class="text-link" href="/getting-started">Full setup guide →</a>
    </div>
    <div class="install-tabs" data-install-tabs>
      <div class="tab-list" role="tablist" aria-label="dotcfg installation formats">
        <button class="tab active" type="button" data-tab="toml">TOML <small>default</small></button>
        <button class="tab" type="button" data-tab="json">JSON</button>
        <button class="tab" type="button" data-tab="yaml">YAML</button>
        <button class="tab" type="button" data-tab="all">All formats</button>
      </div>
      <CodeBlock label="Cargo.toml" code={installValues.toml} compact />
    </div>
    <p class="install-note">Published release: 0.3.0. Explore more on the <a class="inline-link" href="/examples">examples page</a>.</p>
  </section>

  <section>
    <div class="section-heading">
      <div>
        <span class="eyebrow">Your first config</span>
        <h2>Load a typed Rust configuration.</h2>
      </div>
    </div>
    <CodeBlock label="src/main.rs" code={quickStart} lineNumbers />
    <aside class="note" aria-label="Missing configuration">
      <strong>Missing is a choice.</strong>
      <p><code>load()</code> returns <code>Ok(None)</code> when the file is absent. Use <code>load_or_default()</code> to opt into creating it with default values. Parse and I/O errors still propagate.</p>
    </aside>
  </section>

  <div class="cards">
    {topics.map(([title, description, href]) => <a class="card" href={href}><strong>{title}</strong><p>{description}</p><span>Read guide →</span></a>)}
  </div>

  <section class="examples-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Practical examples</span>
        <h2>Common things you’ll do with config.</h2>
      </div>
      <a class="text-link" href="/examples">All examples →</a>
    </div>
    <div class="example-list">
      {examples.map(([title, description, href]) => <a href={href} class="example-row"><div><strong>{title}</strong><p>{description}</p></div><span>→</span></a>)}
    </div>
  </section>

  <section class="api-section">
    <div>
      <h2>Need the full API?</h2>
      <p>Every method, type, and error is in the Rust reference.</p>
    </div>
    <a class="text-link" href="https://docs.rs/dotcfg">Open docs.rs ↗</a>
  </section>

  <script is:inline define:vars={{ installValues }}>
    document.querySelectorAll('[data-install-tabs] .tab').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.tab;
        const code = document.querySelector('[data-install-tabs] [data-code-block] code');
        if (!key || !code) return;
        code.textContent = installValues[key];
        document.querySelectorAll('[data-install-tabs] .tab').forEach((tab) => tab.classList.remove('active'));
        button.classList.add('active');
      });
    });
  </script>
</DocsLayout>

<style>
  .tab-list { flex-wrap: wrap; }
  .install-note { margin: 12px 0 0; color: var(--muted); font-size: 13px; }
  .api-section { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; padding: 24px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
  .api-section h2 { margin: 0; }
  .api-section p { margin: 8px 0 0; color: var(--muted); }
</style>
