---
import DocsLayout from "../layouts/DocsLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
const recipes = [
  { title: "Optional configuration", text: "Run normally when no config file exists.", code: `let config: Option<AppConfig> = cfg.load()?;` },
  { title: "Required configuration", text: "Fail when the application has not been configured yet.", code: `let config: AppConfig = cfg.load_or_error()?;` },
  { title: "Create a default config", text: "Create the file from your struct's Default implementation.", code: `let config: AppConfig = cfg.load_or_default()?;` },
  { title: "Change one typed value", text: "Update one field without rebuilding the whole config struct.", code: `cfg.set_val("server.port", 8080u16)?;\nlet port: u16 = cfg.get_as("server.port")?;` },
  { title: "Use a custom directory", text: "Useful for tests, portable setups, and project-local config.", code: `let cfg = DotCfg::new("mytool")\n    .at_dir("./.config");` },
  { title: "Discover project configuration", text: "Run a developer tool from a nested directory and find the nearest project config.", code: `let cfg = DotCfg::new("mytool")\n    .find_in_ancestors()?;` },
  { title: "Environment-first reads", text: "Let deployment or shell values override the saved file.", code: `let cfg = DotCfg::new("mytool")\n    .with_env_prefix("myapp");\nlet port: u16 = cfg.get_as("port")?;` },
];
const cliPattern = `let saved: AppConfig = cfg.load()?.unwrap_or_default();

let active = AppConfig {
    host: args.host.unwrap_or(saved.host),
    port: args.port.unwrap_or(saved.port),
    log_level: args.log_level.unwrap_or(saved.log_level),
};`;
---
<DocsLayout title="Examples — dotcfg" description="Small, practical dotcfg recipes you can adapt to real Rust applications.">
  <article class="prose">
    <span class="eyebrow">Recipes</span><h1>Examples</h1>
    <p class="lead">These are intentionally small snippets: copy the pattern you need, then shape the config type around your application. As real-world dotcfg integrations appear, this page can grow a separate showcase without turning the core docs into a gallery.</p>

    <div class="recipe-list">
      {recipes.map((recipe) => <section class="recipe"><h2>{recipe.title}</h2><p>{recipe.text}</p><CodeBlock label="Rust" code={recipe.code} /></section>)}
    </div>

    <h2>CLI flags over saved config</h2>
    <p>The repository includes a complete Clap example using a common precedence pattern: CLI argument → config file → default value.</p>
    <CodeBlock label="Pattern" code={cliPattern} />

    <p class="next-link"><a class="inline-link" href="https://github.com/Spectra010s/dotcfg/tree/main/examples">Browse the repository examples ↗</a></p>
  </article>
</DocsLayout>
